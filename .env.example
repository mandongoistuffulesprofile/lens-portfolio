# Copy to .env (or set in your host's dashboard). NEVER commit the real file.
ADMIN_PASSWORD=change-me-to-a-long-passphrase
NODE_ENV=production
PORT=3000
# Public URL (used for link previews). Optional.
BASE_URL=https://yourdomain.com
# Set to 1 when running behind nginx/Caddy/Cloudflare so real IPs and https are detected
TRUST_PROXY=1
# Optional: fixed session secret (otherwise generated once into data/.secret)
# SESSION_SECRET=
# DATA_DIR=./data
# MAX_PHOTOS=300
